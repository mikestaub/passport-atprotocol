{
    "compilerOptions": {
      "module": "esnext",
      "target": "es2015",
      "lib": ["es2015", "es2016", "es2017", "es2018", "esnext"],
      "noImplicitAny": false,
      "removeComments": false,
      "declaration": true,
      "preserveConstEnums": true,
      "outDir": "./dist",
      "sourceMap": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "esModuleInterop": true
    },
    "include": [
      "src/**/*"
    ],
    "exclude": [
      "node_modules",
      "**/*.spec.ts"
    ]
  }
